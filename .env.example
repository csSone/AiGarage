# AiGarage Environment Configuration

# Model Server Configuration
# Required: Path to the model files for vLLM inference
export MODEL_PATH=/path/to/your/model

# Optional: Model server port (default: 8000)
export PORT=8000

# Backend Configuration (for legacy/manual deployment)
# Optional: Backend directory path (default: backend)
export BACKEND_PATH=backend

# Docker Deployment Options
# Optional: Skip model server startup if running separately (default: false)
# export SKIP_MODEL_SERVER=false

# Docker Options
# Optional: Custom docker-compose file
# export COMPOSE_FILE=docker-compose.yml

# Development Options
# Optional: Enable debug mode
# export DEBUG=false

# Legacy Configuration (kept for compatibility)
export BASE=1