# AiGarage Environment Configuration

# Model Server Configuration
# The model_server now acts as a proxy/gateway to multiple AI providers

# Required: API keys for AI providers
export OPENAI_API_KEY=sk-your-openai-api-key
export ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
export GOOGLE_API_KEY=your-google-ai-api-key
export ZAI_API_KEY=your-zai-api-key

# Optional: Custom base URLs for providers (for proxies/compatibility layers)
# export OPENAI_BASE_URL=https://api.openai.com/v1
# export ANTHROPIC_BASE_URL=https://api.anthropic.com
# export ZAI_BASE_URL=https://api.zai.ai/v1

# Optional: Model server port (default: 8000)
export PORT=8000

# Optional: Log level (default: info)
export LOG_LEVEL=info

# Legacy: Path to local model files (only needed for local vLLM deployment)
# export MODEL_PATH=/path/to/your/model

# Backend Configuration (for legacy/manual deployment)
# Optional: Backend directory path (default: backend)
export BACKEND_PATH=backend

# Docker Deployment Options
# Optional: Skip model server startup if running separately (default: false)
# export SKIP_MODEL_SERVER=false

# Docker Options
# Optional: Custom docker-compose file
# export COMPOSE_FILE=docker-compose.yml

# Development Options
# Optional: Enable debug mode
# export DEBUG=false

# Legacy Configuration (kept for compatibility)
export BASE=1